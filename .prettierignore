# 🔴 Prettier v3 does NOT read .gitignore, and the format script globs
# `**/*.{ts,tsx,css,md,json}` — so without this file `pnpm format` rewrites
# build output and generated code. Keep them out.

# Dependencies & build output
node_modules
.next
out

# Test / tooling artifacts
coverage
playwright-report
test-results
.playwright-mcp
*.tsbuildinfo

# Generated by `next dev` / `next typegen`
next-env.d.ts

# Lockfiles
pnpm-lock.yaml
